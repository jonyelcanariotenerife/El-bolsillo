{
  "name": "bolsillo-app",
  "version": "1.0.0",
  "description": "Quantum Finance · Bolsillo — app de gastos empaquetada con Capacitor",
  "private": true,
  "scripts": {
    "sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#020205' --iconBackgroundColorDark '#020205' --splashBackgroundColor '#020205' --splashBackgroundColorDark '#020205'",
    "build:android": "npx cap sync android && cd android && ./gradlew assembleRelease",
    "build:android:bundle": "npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "typescript": "^7.0.2"
  }
}
