<!--
  NO sustituyas tu AndroidManifest.xml por esto. Es un fragmento que hay que
  pegar DENTRO de la etiqueta <application> ya existente en:
    android/app/src/main/AndroidManifest.xml
  (al lado de la <activity android:name=".MainActivity" ...> que ya tienes).

  android:exported="true" es obligatorio aquí (no es un agujero de seguridad):
  el sistema Android necesita poder enviarle el broadcast APPWIDGET_UPDATE al
  receiver desde fuera de tu proceso para que el widget funcione.
-->
<receiver
    android:name=".BolsilloWidgetProvider"
    android:exported="true"
    android:label="Bolsillo">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
    </intent-filter>
    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/bolsillo_widget_info" />
</receiver>
